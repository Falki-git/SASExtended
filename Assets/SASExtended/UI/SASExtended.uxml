<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SASExtended/UI/SASExtended.uss?fileID=7433441132597879392&amp;guid=4e53402c9d91b0c409b2983ca8b94a72&amp;type=3#SASExtended"/>
    <ui:VisualElement name="root" class="root main-gui">
        <ui:VisualElement name="footer" class="footer" style="display: flex;">
            <ui:Label tabindex="-1" text="Overlay: ON" display-tooltip-when-elided="true" name="notification" picking-mode="Ignore" class="notification" style="display: none;"/>
            <ui:Label text="" name="status" class="status-label" style="display: flex;"/>
        </ui:VisualElement>
        <ui:VisualElement name="middle-container" class="middle-container">
            <ui:VisualElement name="body" class="body">
                <ui:VisualElement name="orb-container" class="mode-container" style="display: flex;">
                    <ui:VisualElement name="row-1" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 20%; width: 100%; align-items: center; margin-top: 5px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="PRO\nGRADE" IsEnabled="true" IsSmall="false" IsBig="true" IsToggled="false" name="prograde"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="NORM" IsBig="true" IsEnabled="true" name="normal"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="RAD\nOUT" IsBig="true" IsEnabled="true" name="radialin"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 25%; width: 100%; align-items: center;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="RETRO\nGRADE" IsBig="true" IsEnabled="true" name="retrograde"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="ANTI\nNORM" IsBig="true" IsEnabled="true" name="antinormal"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="RAD\nIN" IsBig="true" IsEnabled="true" name="radialout"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="surf-container" class="mode-container" style="display: none;">
                    <ui:VisualElement name="row-1" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 20%; width: 100%; align-items: center; margin-top: 5px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="S VEL\n+" IsEnabled="true" IsSmall="false" IsBig="true" IsToggled="false" name="svelplus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="H VEL\n+" IsBig="true" IsEnabled="true" name="hvelplus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="SURF" IsBig="true" IsEnabled="true" name="surf"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 25%; width: 100%; align-items: center;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="S VEL\n-" IsBig="true" IsEnabled="true" name="svelminus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="H VEL\n-" IsBig="true" IsEnabled="true" name="hvelminus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="UP" IsBig="true" IsEnabled="true" name="up"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tgt-container" class="mode-container" style="display: none;">
                    <ui:VisualElement name="row-1" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 20%; width: 100%; align-items: center; margin-top: 5px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="TGT\n+" IsEnabled="true" IsSmall="false" IsBig="true" IsToggled="false" name="tgtplus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="R VEL\n+" IsBig="true" IsEnabled="true" name="rvelplus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="PAR\n+" IsBig="true" IsEnabled="true" name="parplus"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 25%; width: 100%; align-items: center;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="TGT\n-" IsBig="true" IsEnabled="true" name="tgtminus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="R VEL\n-" IsBig="true" IsEnabled="true" name="rvelminus"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="PAR\n-" IsBig="true" IsEnabled="true" name="parminus"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="spec-container" class="mode-container" style="display: none;">
                    <ui:VisualElement name="row-1" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 20%; width: 100%; align-items: center; margin-top: 5px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="HOVER" IsEnabled="true" IsSmall="false" IsBig="true" IsToggled="false" name="hover"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="HOLD" IsBig="true" IsEnabled="true" name="hold"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="STAR\n+" IsBig="true" IsEnabled="true" name="starplus"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-around; height: 25%; width: 100%; align-items: center;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="STAR\n-" IsBig="true" IsEnabled="true" style="visibility: hidden;"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="5" IsBig="true" IsEnabled="true" style="visibility: hidden;"/>
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="STAR\n-" IsBig="true" IsEnabled="true" name="starminus"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="attitude-controls" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 50%; padding-top: 0; padding-bottom: 5px; width: 100%; padding-left: 0; padding-right: 0; align-items: center;">
                    <ui:VisualElement name="heading-row" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 30%; flex-direction: row; -unity-text-align: middle-left; padding-top: 2px; padding-bottom: 2px; align-items: center; width: 100%; justify-content: space-around; padding-right: 2px; padding-left: 2px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="HEADING" IsSmall="true" IsEnabled="true" IsToggled="true" name="x-toggle"/>
                        <ui:FloatField value="0" name="x-value" class="attitude-input-field"/>
                        <ui:Label tabindex="-1" text="°" display-tooltip-when-elided="true" style="font-size: 10px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 5px;"/>
                        <ui:Button text="-" display-tooltip-when-elided="true" name="x-minus" class="attitude__button"/>
                        <ui:Button text="+" display-tooltip-when-elided="true" name="x-plus" class="attitude__button"/>
                        <ui:Button text="0" display-tooltip-when-elided="true" name="x-first" class="attitude__button"/>
                        <ui:Button text="90" display-tooltip-when-elided="true" name="x-second" class="attitude__button" style="width: 20px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="pitch-row" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 30%; flex-direction: row; -unity-text-align: middle-left; padding-bottom: 2px; padding-top: 2px; align-items: center; width: 100%; padding-left: 2px; padding-right: 2px; justify-content: space-around;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="PITCH" IsSmall="true" IsToggled="true" IsEnabled="true" name="y-toggle"/>
                        <ui:FloatField value="0" name="y-value" class="attitude-input-field"/>
                        <ui:Label tabindex="-1" text="°" display-tooltip-when-elided="true" style="font-size: 10px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 5px;"/>
                        <ui:Button text="-" display-tooltip-when-elided="true" name="y-minus" class="attitude__button"/>
                        <ui:Button text="+" display-tooltip-when-elided="true" name="y-plus" class="attitude__button"/>
                        <ui:Button text="0" display-tooltip-when-elided="true" name="y-first" class="attitude__button"/>
                        <ui:Button text="90" display-tooltip-when-elided="true" name="y-second" class="attitude__button" style="width: 20px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="roll-row" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 30%; flex-direction: row; -unity-text-align: middle-left; padding-top: 2px; padding-bottom: 2px; align-items: center; width: 100%; padding-left: 2px; padding-right: 2px; justify-content: space-around;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="ROLL" IsSmall="true" IsEnabled="true" IsToggled="true" name="z-toggle"/>
                        <ui:FloatField value="0" name="z-value" class="attitude-input-field"/>
                        <ui:Label tabindex="-1" text="°" display-tooltip-when-elided="true" style="font-size: 10px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 5px;"/>
                        <ui:Button text="-" display-tooltip-when-elided="true" name="z-minus" class="attitude__button"/>
                        <ui:Button text="+" display-tooltip-when-elided="true" name="z-plus" class="attitude__button"/>
                        <ui:Button text="0" display-tooltip-when-elided="true" name="z-first" class="attitude__button"/>
                        <ui:Button text="180" display-tooltip-when-elided="true" name="z-second" class="attitude__button" style="width: 20px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hover-controls" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 50%; padding-top: 0; padding-bottom: 5px; width: 100%; padding-left: 0; padding-right: 0; align-items: center; display: none;">
                    <ui:VisualElement name="first-row" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 30%; flex-direction: row; -unity-text-align: middle-left; padding-top: 2px; padding-bottom: 2px; align-items: center; width: 100%; justify-content: space-around; padding-right: 2px; padding-left: 2px;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="V-SPD" IsSmall="true" IsEnabled="true" IsToggled="true" name="ver-vel-toggle"/>
                        <ui:FloatField value="0" name="ver-vel-value" class="velocity-input-field"/>
                        <ui:Label tabindex="-1" text="m/s" display-tooltip-when-elided="true" style="font-size: 10px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 22px;"/>
                        <ui:Button text="-" display-tooltip-when-elided="true" name="ver-vel-minus" class="attitude__button"/>
                        <ui:Button text="+" display-tooltip-when-elided="true" name="ver-vel-plus" class="attitude__button"/>
                        <ui:Button text="0" display-tooltip-when-elided="true" name="ver-vel-zero" class="attitude__button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="second-row" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 30%; flex-direction: row; -unity-text-align: middle-left; padding-bottom: 2px; padding-top: 2px; align-items: center; width: 100%; padding-left: 2px; padding-right: 2px; justify-content: space-around;">
                        <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="CANCEL H-SPD" IsSmall="true" IsToggled="true" IsEnabled="true" name="cancel-horizontal-velocity" IsLong="true"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tabs" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); max-height: 30px; min-height: 30px; flex-direction: row; align-items: flex-end;">
                <SASExtended.UI.Controls.TabToggleControl focusable="true" Text="ORB" name="orb-tab" IsEnabled="true" IsToggled="true"/>
                <SASExtended.UI.Controls.TabToggleControl focusable="true" Text="SURF" name="surf-tab" IsEnabled="true"/>
                <SASExtended.UI.Controls.TabToggleControl focusable="true" Text="TGT" name="tgt-tab" IsEnabled="true"/>
                <SASExtended.UI.Controls.TabToggleControl focusable="true" Text="SPEC" name="spec-tab" IsEnabled="true"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="upper-container" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-between; padding-bottom: 10px; padding-left: 0; padding-right: 0; margin-bottom: 10px; height: 10%; flex-shrink: 0;">
            <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="OFF" IsEnabled="true" IsBig="false" name="off"/>
            <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="KILL\nROT" IsEnabled="true" IsToggled="false" IsBig="false" name="killrot" parse-escape-sequences="true"/>
            <SASExtended.UI.Controls.SideToggleControl focusable="true" Text="NODE" IsEnabled="true" name="node"/>
        </ui:VisualElement>
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement name="title__container" class="title__container">
                <ui:VisualElement name="icon" class="icon"/>
                <ui:Label tabindex="-1" text="SAS EXTENDED" display-tooltip-when-elided="true" name="title-text" class="title-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="close-button__container" class="close-button__container">
                <ui:Button name="close-button" class="close-button">
                    <ui:VisualElement name="close-button__background" class="close-button__background" style="background-image: url(&quot;project://database/Assets/SASExtended/UI/Images/Icons/ICO-Close-med.png?fileID=2800000&amp;guid=456a2a06d20612f4e96d2227e8ca601d&amp;type=3#ICO-Close-med&quot;);"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
